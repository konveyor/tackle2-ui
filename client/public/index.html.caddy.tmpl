<!DOCTYPE html>
<html lang="en-US">
  <head>
    <!-- Branding values below are injected at build time by HtmlRspackPlugin. -->
    <title><%= brandingTitle %></title>
    <meta name="description" content="<%= brandingDescription %>" />
    <meta id="appName" name="application-name" content="<%= brandingName %>" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="version" content="2.0.0" />
    <link rel="manifest" href="manifest.json" />
    <base href="/" />
    <script>
      // Caddy embeds the HTML-safe JSON served by /.env at request time.
      // The development plugin substitutes the same config at build time.
      window._env = {{httpInclude "/.env"}};
    </script>
  </head>
  <body>
    <noscript>You need to enable JavaScript to run this app.</noscript>
    <div id="root" style="height: 100%"></div>
  </body>
</html>
