# Production Caddyfile for tackle2-ui.
# Loaded from /etc/caddy/Caddyfile inside the hardened Caddy container.
#
# Required env vars (validated by the Go entrypoint before Caddy starts):
#   TACKLE_HUB_URL    - Hub API upstream URL
#   OIDC_ISSUER       - OIDC issuer URL (required unless AUTH_REQUIRED=false)
#   OIDC_CLIENT_ID    - OIDC client ID  (required unless AUTH_REQUIRED=false)
#
# Optional env vars:
#   PORT              - Listen port (default: 8080)
#   KAI_LLM_PROXY_URL - LLM proxy upstream URL
#   KEYCLOAK_SERVER_URL - Legacy Keycloak upstream URL
#
# Runtime ClientEnv is served as JSON at /.env and included in index.html.
# Public roots and optional cluster/custom CAs are assembled by the entrypoint;
# Go's TLS stack consumes the resulting SSL_CERT_FILE for upstream connections.
{
	# TLS is terminated at the ingress / load balancer — disable auto HTTPS.
	auto_https off

	# Disable configuration autosave
	persist_config off

	# Disable the admin endpoint and the `caddy reload` command
	admin off
}

import /etc/caddy/proxy-routes.caddy

:{$PORT:8080} {
	import api_routes false

	# Runtime configuration belongs only to production. In development rspack
	# serves /.env from the same ClientEnv used by its HTML plugin.
	handle /.env {
		root * /etc/caddy
		rewrite * /env.json.tmpl
		request_header -If-None-Match
		request_header -If-Modified-Since
		request_header -Range
		header {
			Content-Type application/json
			Cache-Control no-store
		}
		templates {
			mime application/json
		}
		file_server
	}

	# Serve the pre-built SPA from /srv (populated by the Dockerfile COPY step).
	root * /srv

	# Keep SPA rewrites separate from API and runtime configuration routes.
	handle {
		route {
			try_files {path} /index.html

			# Root may still be a directory after try_files. Handle it explicitly
			# so file_server's implicit index also gets runtime templating.
			@index path / /index.html
			handle @index {
				# Static validators/ranges cannot describe runtime-templated content.
				request_header -If-None-Match
				request_header -If-Modified-Since
				request_header -Range
				header Cache-Control no-store
				templates
				file_server
			}

			handle {
				file_server {
					precompressed br gzip
				}
			}
		}
	}
}
