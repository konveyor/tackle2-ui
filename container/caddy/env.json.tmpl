{{- /* Keep defaults in sync with client/src/env/types.ts. mustToJson escapes
quotes, control characters and HTML. Escape template openers too because Caddy's
httpInclude evaluates its response as a template a second time. */ -}}
{{- dict
  "NODE_ENV" (env "NODE_ENV" | default "production")
  "VERSION" (env "VERSION" | default "99.0.0")
  "MOCK" (env "MOCK" | default "off")
  "DEVTOOLS" (env "DEVTOOLS" | default "off")
  "UI_INGRESS_PROXY_BODY_SIZE" (env "UI_INGRESS_PROXY_BODY_SIZE" | default "500m")
  "RWX_SUPPORTED" (env "RWX_SUPPORTED" | default "true")
  "AUTH_REQUIRED" (env "AUTH_REQUIRED" | default "false")
  "AGENTIC_ENABLED" (env "AGENTIC_ENABLED" | default "false")
  "AGENTIC_STEER_ENABLED" (env "AGENTIC_STEER_ENABLED" | default "false")
  "OIDC_CLIENT_ID" (env "OIDC_CLIENT_ID" | default "web-ui")
  | mustToJson | replace "{{" "\\u007b\\u007b"
-}}
